# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Secrets
.env

# Runtime data (keep the folders, ignore their contents)
data/*
!data/.gitkeep
images/*
!images/.gitkeep
logs/*
!logs/.gitkeep
data/*.db
data/*.db-journal

# backups/ is NOT ignored — it's the git-tracked backup destination (see CLAUDE.md > Backup & Restore)

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/settings.local.json

# Maintainer's own scratch review-prompt template — not part of the app, deliberately kept
# local-only (previously untracked by hand in commit ee46a32; gitignored here so it stops
# tripping scripts/deploy.py's clean-working-tree check).
comprehensive-code-review-prompt.md
