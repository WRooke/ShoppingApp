# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

PORT=8080

# CORS: comma-separated exact origins allowed to call this API cross-origin (see
# CLAUDE.md > Security §4). Defaults below cover local dev only. Once the NUC has a
# static IP (SETUP.md step 5), add it here, e.g.:
#   ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.10:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Phase 3 — Claude recipe extraction. Not required to run Phase 1/2.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Master switch — a real Claude call is refused unless this is explicitly "true", even with a
# valid key (CLAUDE.md > Security > §0c). Off by default; turn on yourself when ready to
# actually use recipe capture for real. (A hard AU$0.50 spend cap used to sit alongside this
# as MAX_API_SPEND_AUD_CENTS — removed 2026-09-06, see CLAUDE.md's Non-Negotiable Operating
# Rules banner; Anthropic billing is prepaid, so there's no runaway-invoice risk for an in-app
# cap to guard against. Cost is still tracked for visibility — see Security > §0b.)
CLAUDE_API_ENABLED=false

# Dev-only: "true" makes extraction return a canned fixture instead of calling the real API —
# zero cost, zero network, works with no key at all (CLAUDE.md > Security > §0c). Lets the
# capture endpoints/review UI be built and clicked through without touching the real API.
# Never set this true outside local development.
CLAUDE_API_FAKE_MODE=false

# Phase 5 — AnyList integration. Not required to run Phase 1-4.
ANYLIST_EMAIL=REPLACE_ME
ANYLIST_PASSWORD=REPLACE_ME

# Which AnyList list to read/write. Dev default is a separate test list so
# nothing ever touches the real household list by accident — switch this to
# the real list name when ready for production use (Phase 5+).
ANYLIST_TARGET_LIST_NAME=TestList

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Paths are resolved relative to the project root.
DATABASE_PATH=data/mealplanner.db
IMAGES_PATH=images
LOGS_PATH=logs
