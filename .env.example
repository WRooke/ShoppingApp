# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

PORT=8080

# CORS: comma-separated exact origins allowed to call this API cross-origin (see
# docs/security.md > App-level protections). Defaults below cover local dev only. Once the NUC has a
# static IP (SETUP.md step 5), add it here, e.g.:
#   ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.10:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# AI recipe import (Google Gemini; see docs/recipe-capture.md > AI Provider Migration).
# Optional: the app runs without it, with AI import switched off.
GEMINI_API_KEY=REPLACE_ME

# Master switch — a real Gemini call is refused unless this is explicitly "true", even with a
# valid key (docs/security.md > API enable switch). Off by default; turn on yourself when ready to
# actually use recipe capture for real. Gemini's free tier has no per-call dollar cost.
AI_EXTRACTION_ENABLED=false

# Dev/test only ("fake mode"): "true" returns built-in sample results instead of calling the real API —
# zero cost, zero network, works with no key at all (docs/security.md > API enable switch). Lets the
# capture endpoints/review UI be built and clicked through without touching the real API.
# Never set this true outside local development.
AI_EXTRACTION_FAKE_MODE=false

# AnyList integration (sending the checklist to AnyList). Optional: without it you can still build
# the checklist, but not send it.
#
# Credentials are hybrid (docs/security.md > AnyList credentials): the app reads Windows Credential Manager
# FIRST, and only falls back to these .env values (with a logged warning) if the keyring
# entries aren't set. To use the keyring instead of plaintext here, run once:
#   keyring set shoppingapp anylist_email
#   keyring set shoppingapp anylist_password
# ...and leave these two as REPLACE_ME.
ANYLIST_EMAIL=REPLACE_ME
ANYLIST_PASSWORD=REPLACE_ME

# Master switch — a real AnyList call is refused unless this is explicitly "true" (mirrors
# AI_EXTRACTION_ENABLED; see docs/security.md > AnyList credentials). Off by default.
ANYLIST_ENABLED=false

# Dev-only: "true" swaps in an in-memory fake list so the checklist + push flow runs with no
# account and no network. Never set true on the NUC.
ANYLIST_FAKE_MODE=false

# Which AnyList list to read/write. Dev default is a separate test list so nothing ever
# touches the real household list by accident — switch this to the real list name only when
# ready for production use, and only with the project owner's explicit approval for that run.
ANYLIST_TARGET_LIST_NAME=TestList

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Paths are resolved relative to the project root.
DATABASE_PATH=data/mealplanner.db
IMAGES_PATH=images
LOGS_PATH=logs
