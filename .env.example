# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

PORT=8080

# CORS: comma-separated exact origins allowed to call this API cross-origin (see
# CLAUDE.md > Security §4). Defaults below cover local dev only. Once the NUC has a
# static IP (SETUP.md step 5), add it here, e.g.:
#   ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.10:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Phase 3 — Claude recipe extraction. Not required to run Phase 1/2.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Hard cap on total Claude API spend, in Australian cents — highest-priority standing rule,
# set 2026-09-05 (see CLAUDE.md > Security > API Spend Cap). Every extraction call is refused
# once total spend would reach this figure. Raising it is a deliberate maintainer decision —
# edit this value yourself; an agent session should never raise it on its own initiative.
MAX_API_SPEND_AUD_CENTS=50

# Phase 5 — AnyList integration. Not required to run Phase 1-4.
ANYLIST_EMAIL=REPLACE_ME
ANYLIST_PASSWORD=REPLACE_ME

# Which AnyList list to read/write. Dev default is a separate test list so
# nothing ever touches the real household list by accident — switch this to
# the real list name when ready for production use (Phase 5+).
ANYLIST_TARGET_LIST_NAME=TestList

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Paths are resolved relative to the project root.
DATABASE_PATH=data/mealplanner.db
IMAGES_PATH=images
LOGS_PATH=logs
